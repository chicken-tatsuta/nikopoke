# Supabase
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxx

# Cloudflare TURN (optional - if omitted, falls back to STUN only)
# 1. Go to https://dash.cloudflare.com/?to=/:account/rtc/turn
# 2. Create a TURN key
# 3. Copy the Key ID and API Token here
VITE_CLOUDFLARE_TURN_KEY_ID=
VITE_CLOUDFLARE_TURN_API_TOKEN=

# PeerJS signaling server (optional - if omitted, uses default 0.peerjs.com)
# You can self-host: https://github.com/peers/peerjs-server
VITE_PEERJS_HOST=
VITE_PEERJS_PORT=443
VITE_PEERJS_PATH=/peerjs
VITE_PEERJS_KEY=peerjs
